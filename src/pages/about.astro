---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sigil from '../components/Sigil.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../utils/content';

const writeups = await getCollection('writeups');
const research = await getCollection('research');
const categoryCount = new Set(writeups.map((post) => post.data.category)).size;

const achievements = [
  ['01', '2026', 'FPT Future Tech Talents 2026', 'Next-Gen Talents award', 'Award'],
  ['02', '2024', 'Google Cybersecurity Professional Certificate', 'Professional certificate', 'Cert'],
  ['03', '2024', 'Google AI Essentials', 'AI fundamentals certificate', 'Cert'],
  ['04', '2024', 'Google Project Management Professional Certificate', 'Professional certificate', 'Cert'],
  ['05', '2025', 'Google Prompting Essentials', 'Prompting certificate', 'Cert'],
  ['06', '2024', 'IELTS Academic 8.0', 'CEFR C1, four skills', 'Test'],
  ['07', '2026', 'JLPT N3', 'Passed, 111/180', 'Test'],
  ['08', '2024', 'Provincial English Olympiad', 'First prize, grade 12', 'Award'],
  ['09', '2023', 'Provincial English Olympiad', 'Encouragement prize, grade 11', 'Award'],
  ['10', '2023', 'National English Olympiad', 'Provincial training team', 'Select'],
  ['11', '2026', 'OpenAI Build Week', 'First place, AI pentesting agent', 'Award'],
  ['12', '2026', 'Team 0xHUST — BKSEC', '19 top-20 finishes', 'Team'],
  ['13', '2026', 'Team ite25', 'Top 10% Southeast Asia', 'Team'],
  ['14', '2026', 'NDIAS Automotive/IoT CTF', '8th of 419', 'CTF'],
  ['15', '2026', '0xV01D CTF', '14th of 688', 'CTF'],
  ['16', '2026', 'No Hack No CTF', '17th of 844', 'CTF'],
  ['17', '2026', 'Grey Cat The Flag Qualifiers', '54th of 418', 'CTF'],
  ['18', '2026', 'GPN CTF', '56th of 613', 'CTF'],
  ['19', '2026', 'UIUCTF', '109th of 548', 'CTF'],
  ['20', '2026', 'Crackmes.one RE CTF', 'Hall of Fame #91', 'RE'],
  ['21', '2026', 'Athena CTF 2026', 'Rank #6', 'CTF'],
  ['22', '2026', 'Flare-On 13 — Google Cloud', 'Rank 70, 9/9 solves', 'RE'],
  ['23', '2026', 'HUST Student Research Conference', 'Co-author, shellcode loaders', 'Research'],
].sort((a, b) => Number(b[1]) - Number(a[1]));
---

<BaseLayout
  title="About — Field Archive"
  description="About the archive and its focus on reverse engineering and digital forensics."
>
  <header class="about-hero">
    <div class="about-hero__mark">
      <Sigil size="large" />
      <span>REVERSE / FORENSICS</span>
    </div>
    <div class="about-hero__copy">
      <p class="eyebrow">About</p>
      <h1>Reverse engineering<br /><em>& digital forensics.</em></h1>
      <p>
        My name is Thinh. My current interests are Reverse Engineering and Digital Forensics.
        This site collects my CTF writeups and academic notes.
      </p>
      <div class="about-hero__links">
        <a class="button button--strike" href="https://github.com/loegaire">GitHub ↗</a>
        <a class="button button--paper" href="https://ctftime.org/team/374531">CTFtime ↗</a>
      </div>
    </div>
  </header>

  <section class="about-ledger section-shell">
    <div class="about-ledger__intro">
      <p class="eyebrow">Markdown-first publishing</p>
      <h2>How the archive works.</h2>
      <p>
        The source text comes from the original Markdown documents. The import step adds
        metadata, copies referenced media, normalizes local paths, and removes obvious
        service credentials before Astro builds the static site.
      </p>
    </div>
    <dl>
      <div><dt>01 / Collect</dt><dd>Discover authored notes and writeups under <code>~/ctf</code>.</dd></div>
      <div><dt>02 / Preserve</dt><dd>Keep the original document body and referenced attachments.</dd></div>
      <div><dt>03 / Label</dt><dd>Add event, discipline, status, date, and reading-time metadata.</dd></div>
      <div><dt>04 / Build</dt><dd>Render each Markdown file through Astro content collections.</dd></div>
    </dl>
  </section>

  <section class="profile-stats">
    <div><strong>{writeups.length}</strong><span>CTF records indexed</span></div>
    <div><strong>{research.length}</strong><span>research documents</span></div>
    <div><strong>{categoryCount}</strong><span>technical disciplines</span></div>
  </section>

  <section class="section-shell" id="awards">
    <div class="section-heading section-heading--split">
      <div>
        <p class="eyebrow">Awards &amp; certificates</p>
        <h2>My name on ledgers.</h2>
      </div>
      <p>Records, papers.</p>
    </div>
    <div class="latest-list">
      {achievements.map(([num, year, title, description, kind], index) => (
        <a
          class="latest-row"
          href={withBase(`/aboutme/achievements/${num}.pdf`)}
          target="_blank"
          rel="noreferrer"
        >
          <span class="latest-row__index">{String(index + 1).padStart(2, '0')}</span>
          <span class="latest-row__status">{year}</span>
          <strong>{title}</strong>
          <span>{description}</span>
          <span>{kind}</span>
          <svg viewBox="0 0 52 32" aria-hidden="true"><path d="M2 16h43M32 3l13 13-13 13" /></svg>
        </a>
      ))}
    </div>
  </section>

  <section class="about-cta">
    <p>CTF writeups archive</p>
    <h2>Browse the original<br />notes and writeups.</h2>
    <a class="button button--strike" href={withBase('/archive/')}>Open the archive</a>
  </section>
</BaseLayout>
