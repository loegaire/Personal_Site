---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Sigil from '../components/Sigil.astro';
import { postPath, sortPosts, withBase, type AnyPost } from '../utils/content';

const writeups = await getCollection('writeups');
const research = await getCollection('research');
const allPosts = sortPosts([...writeups, ...research] as AnyPost[]);
const featured = allPosts.filter((post) => post.data.featured).slice(0, 5);
const latest = allPosts.slice(0, 8);
const categoryCounts = allPosts.reduce<Record<string, number>>((counts, post) => {
  counts[post.data.category] = (counts[post.data.category] || 0) + 1;
  return counts;
}, {});
const eventCount = new Set(writeups.map((post) => post.data.event)).size;
const categoryRows = Object.entries(categoryCounts)
  .filter(([category]) => category !== 'Research')
  .sort((a, b) => b[1] - a[1])
  .slice(0, 6);
---

<BaseLayout>
  <section class="hero">
    <div class="hero__ink" aria-hidden="true"></div>
    <div class="hero__copy">
      <p class="hero__issue"><span>FIELD ARCHIVE</span> ISSUE 026 / EASTERN TIME</p>
      <h1>
        <span class="hero__line hero__line--one">CTF.</span>
        <span class="hero__line hero__line--two">WRITEUPS.</span>
        <span class="hero__line hero__line--three">NOTES.</span>
      </h1>
      <p class="hero__intro">
        A personal collection of Capture The Flag and cybersecurity writeups,
        documenting reverse engineering, exploitation, forensics, and miscellaneous challenges.
      </p>
      <div class="hero__actions">
        <a class="button button--strike" href={withBase('/archive/')}>Enter the archive</a>
        <a class="text-link" href={withBase('/about/')}>Read the field brief <span>↗</span></a>
      </div>
    </div>

    <div class="hero__sigil">
      <div class="hero__orbit hero__orbit--one"></div>
      <div class="hero__orbit hero__orbit--two"></div>
      <Sigil size="large" />
      <span class="hero__sticker">REVERSE ENGINEERING<br />DIGITAL FORENSICS</span>
    </div>

    <dl class="hero__stats">
      <div><dt>Records</dt><dd>{writeups.length}</dd></div>
      <div><dt>Research</dt><dd>{research.length}</dd></div>
      <div><dt>Disciplines</dt><dd>{Object.keys(categoryCounts).length - 1}</dd></div>
      <div><dt>Events</dt><dd>{eventCount}</dd></div>
    </dl>

    <a class="hero__latest" href={postPath(latest[0])}>
      <span>Latest writeup</span>
      <strong>{latest[0].data.title}</strong>
      <svg viewBox="0 0 52 32" aria-hidden="true"><path d="M2 16h43M32 3l13 13-13 13" /></svg>
    </a>
  </section>

  <section class="featured section-shell" aria-labelledby="featured-title">
    <div class="section-heading section-heading--split">
      <div>
        <p class="eyebrow">Selected dossiers / solved paths</p>
        <h2 id="featured-title">Featured records</h2>
      </div>
      <p>Articles, solved challenges, and field notes from the original archive.</p>
    </div>
    <div class="featured-grid">
      {featured.map((post, index) => <PostCard post={post} index={index} />)}
    </div>
  </section>

  <section class="discipline-strip" aria-labelledby="disciplines-title">
    <div class="discipline-strip__title">
      <p class="eyebrow">Signal map</p>
      <h2 id="disciplines-title">By discipline</h2>
    </div>
    <div class="discipline-strip__list">
      {categoryRows.map(([category, count], index) => (
        <a href={`${withBase('/archive/')}?category=${encodeURIComponent(category)}`}>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <strong>{category}</strong>
          <em>{count} records</em>
        </a>
      ))}
    </div>
  </section>

  <section class="latest section-shell" aria-labelledby="latest-title">
    <div class="section-heading section-heading--split">
      <div>
        <p class="eyebrow">Recently touched</p>
        <h2 id="latest-title">Latest dispatches</h2>
      </div>
      <a class="text-link" href={withBase('/archive/')}>View complete ledger <span>↗</span></a>
    </div>
    <div class="latest-list">
      {latest.map((post, index) => (
        <a class="latest-row" href={postPath(post)}>
          <span class="latest-row__index">{String(index + 1).padStart(2, '0')}</span>
          <span class="latest-row__status" data-status={post.data.status}>{post.data.status}</span>
          <strong>{post.data.title}</strong>
          <span>{post.data.category}</span>
          <span>{post.data.readingTime} min</span>
          <svg viewBox="0 0 52 32" aria-hidden="true"><path d="M2 16h43M32 3l13 13-13 13" /></svg>
        </a>
      ))}
    </div>
  </section>

  <section class="manifesto">
    <div class="manifesto__ornament" aria-hidden="true">◆</div>
    <p>From the original archive</p>
    <blockquote>
      “A growing vault of learning, mistakes, techniques, and the occasional triumph.”
    </blockquote>
    <a class="button button--paper" href={withBase('/about/')}>About the archive</a>
  </section>
</BaseLayout>
